# Copy to .env beside ccm.json. Never commit your filled-in .env.
# Generate a unique bootstrap credential with: openssl rand -hex 32
# Required to enable /v1, /api and /mcp; this is NOT your provider API key.
CCM_BOOTSTRAP_ADMIN_KEY=

# Required only for the supplied Ollama Cloud configuration.
# Other OpenAI-compatible providers can use a different api_key_env in ccm.json.
OLLAMA_CLOUD_API_KEY=

# Process settings; defaults shown. JSON configuration overrides model settings.
CCM_CONFIG=ccm.json
CCM_HOST=127.0.0.1
CCM_PORT=8080
CCM_PORTFOLIO_DB=portfolio.db
CCM_TRAFFIC_LOG=ccm-traffic.jsonl
# CCM_MODEL=deepseek-v4.1-flash
# CCM_UPSTREAM_BASE_URL=https://ollama.com/v1
# CCM_MAX_ITERATIONS=2
# CCM_DEBUG=false

# Provider budgets in milliseconds. Total includes retries and backoff.
# CCM_UPSTREAM_CONNECT_TIMEOUT_MS=10000
# CCM_UPSTREAM_FIRST_RESPONSE_TIMEOUT_MS=60000
# CCM_UPSTREAM_IDLE_TIMEOUT_MS=60000
# CCM_UPSTREAM_TOTAL_TIMEOUT_MS=1800000
# CCM_UPSTREAM_MAX_ATTEMPTS=3
# CCM_UPSTREAM_RETRY_BASE_MS=500
# RUST_LOG=ccm=info,tower_http=info
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Full reference, precedence and data handling: docs/CONFIGURATION.md
